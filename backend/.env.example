# EverAfter backend — environment template.
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to git, and never share real secrets.

# Database connection (postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME)
DATABASE_URL=postgresql+psycopg://everafter:CHANGE_ME@localhost:5433/everafter

# Secret used to sign login tokens. Generate a fresh one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Login token lifetime, in days.
TOKEN_EXPIRE_DAYS=7

# bcrypt cost factor. 12 is a good default for 2026.
BCRYPT_ROUNDS=12
